    <decisions>
        <name>Departure_Window</name>
        <label>Departure Window</label>
        <locationX>308</locationX>
        <locationY>410</locationY>
        <defaultConnectorLabel>Far Out</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Offer_Trip_Insurance</targetReference>
        </defaultConnector>
        <rules>
            <name>Last_Minute</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>daysToDeparture</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>7.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Offer_Premium_Seat</targetReference>
            </connector>
            <label>Last Minute (less than 7d)</label>
        </rules>
        <rules>
            <name>Mid_Window</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>daysToDeparture</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Offer_Lounge_Access</targetReference>
            </connector>
            <label>Mid Window (less than 30d)</label>
        </rules>
    </decisions>
